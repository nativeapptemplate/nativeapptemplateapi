<% content_for :title, t(".title", mobile_app: ConfigSettings.display_name) %>

<div class="container px-4 mx-auto my-10 lg:px-0">
  <div class="w-full m-auto lg:w-1/2">
    <div class="p-4 bg-white border border-gray-200 rounded-lg shadow-sm lg:p-10">
      <h2 class="text-3xl font-bold leading-tight"><%= t(".title", mobile_app: ConfigSettings.display_name) %></h2>
      <p class="mt-4 text-gray-700"><%= t(".body") %></p>
      <% @store_links.each do |label, url| %>
        <p class="mt-4"><%= link_to label, url, class: "text-blue-600 underline" %></p>
      <% end %>
    </div>
  </div>
</div>
