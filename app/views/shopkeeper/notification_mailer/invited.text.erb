<%= strip_tags t(".header_html", inviter: @inviter_name, account: @account.name) %>

<%= t(".you_can_accept_or_decline") %>

<%= strip_tags t(".enter_your_invitation_code_in_the_mobile_app_html", mobile_app: ConfigSettings.display_name) %>

<%= strip_tags t(".open_invitation_link_html", link: @invitation_url) %>

<%= t(".instructions_heading") %>
1. <%= strip_tags t(".open_mobile_app_html", mobile_app: ConfigSettings.display_name) %>
2. <%= strip_tags t(".create_account_or_sign_in_with_html", email: @accounts_invitation.email) %>
3. <%= t(".select_organization_tab") %>
4. <%= t(".tap_join_button") %>
5. <%= t(".enter_your_invitation_code") %>
6. <%= t(".if_you_accepted_invitation_switch_to_organization") %>

<%= @accounts_invitation.token %>

<% if @store_links.any? %>
<% @store_links.each do |label, url| %>
<%= label %>: <%= url %>
<% end %>

<% end %>
<%= t(".expires_in", expires_in: ConfigSettings.accounts_invitation.expires_in_hours) %>
