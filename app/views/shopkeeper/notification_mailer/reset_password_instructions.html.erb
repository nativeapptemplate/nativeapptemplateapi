<h1><%= t(:hello_email, email: @resource.email) %></h1>

<p><%= t ".request_reset_link_msg" %></p>

<%= render "shopkeeper/notification_mailer/button", label: t(".password_change_link"), url: edit_shopkeeper_password_url(reset_password_token: @token, config: @client_config, redirect_url: @redirect_url) %>

<p class="divider" style="margin:0;padding-top:16px;border-top:1px solid #E4E7EB;font-size:13px;color:#616E7C;">
  <%= t ".ignore_mail_msg" %>
  <br>
  <%= t ".no_changes_msg" %>
</p>
