<%# The way into the action: a filled Light Blue button with bold white text
    (contrast 5.9:1, so it stays the same in dark mode) %>
<table role="presentation" border="0" cellpadding="0" cellspacing="0" style="margin:8px 0 24px;">
  <tr>
    <td class="button-cell" style="background-color:#0B69A3;border-radius:10px;">
      <a href="<%= url %>" style="display:inline-block;padding:14px 28px;font-size:17px;font-weight:700;line-height:1.2;color:#FFFFFF;text-decoration:none;"><%= label %></a>
    </td>
  </tr>
</table>
