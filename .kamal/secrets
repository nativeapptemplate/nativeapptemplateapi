# Secrets defined here are available for reference under registry/password, env/secret, builder/secrets,
# and accessories/*/env/secret in config/deploy.yml. All secrets should be pulled from either
# password manager, ENV, or a file. DO NOT ENTER RAW CREDENTIALS HERE! This file needs to be safe for git.

# GitHub Container Registry password: a Personal Access Token (classic) with the
# write:packages scope, for the user/org in config/deploy.yml's registry section.
#   export KAMAL_REGISTRY_PASSWORD=ghp_xxxxxxxx
KAMAL_REGISTRY_PASSWORD=$KAMAL_REGISTRY_PASSWORD

# Production credentials key. Decrypts config/credentials/production.yml.enc.
# Never check config/credentials/*.key into git (they're gitignored).
RAILS_MASTER_KEY=$(cat config/credentials/production.key)

# Postgres password for the "db" accessory and the app's database connection.
# Read from an app-specific variable so it can't collide with another app's
# POSTGRES_PASSWORD in the same shell when several apps share one server.
# There is intentionally no fallback: a missing value fails the deploy instead
# of shipping an empty password.
#   export NATIVEAPPTEMPLATEAPI_POSTGRES_PASSWORD=$(openssl rand -hex 32)
# It is baked into the Postgres data volume on the FIRST deploy. Changing it
# later requires also altering the role inside Postgres.
POSTGRES_PASSWORD=$NATIVEAPPTEMPLATEAPI_POSTGRES_PASSWORD
